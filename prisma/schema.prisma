generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model JobWatch { id String @id @default(uuid()) name String enabled Boolean @default(true) description String? schedule String? intervalMinutes Int @default(3) timezone String @default("America/Toronto") sources Json sourceTiers Json companySlugs Json companies Json searchTerms Json requiredTerms Json preferredTerms Json excludedTerms Json locations Json countryCodes Json allowedWorkplaceTypes Json allowedEmploymentTypes Json minimumScore Int @default(60) urgentScore Int @default(80) digestScore Int @default(40) notificationChannels Json initializationMode String @default("baseline") initializedAt DateTime? lastRunAt DateTime? nextRunAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt matches WatchMatch[] runs WatchRun[] @@index([enabled,nextRunAt]) }
model ObservedJob { id String @id @default(uuid()) fingerprint String @unique source String sourceType String? externalJobId String? company String? normalizedCompany String? title String normalizedTitle String location String? normalizedLocation String? workplaceType String? employmentType String? description String? descriptionHash String? jobUrl String? applicationUrl String? sourcePublishedAt DateTime? firstSeenAt DateTime @default(now()) lastSeenAt DateTime @default(now()) closedAt DateTime? rawPayload Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt matches WatchMatch[] @@index([source,externalJobId]) @@index([normalizedCompany]) @@index([sourcePublishedAt]) }
model WatchMatch { id String @id @default(uuid()) watchId String observedJobId String score Int scoreBreakdown Json matchedTerms Json excludedReason String? status String @default("new") firstMatchedAt DateTime @default(now()) lastMatchedAt DateTime @default(now()) notificationState String @default("pending") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt watch JobWatch @relation(fields:[watchId],references:[id],onDelete:Cascade) observedJob ObservedJob @relation(fields:[observedJobId],references:[id],onDelete:Cascade) deliveries NotificationDelivery[] @@unique([watchId,observedJobId]) @@index([watchId,score]) @@index([status]) }
model NotificationDelivery { id String @id @default(uuid()) idempotencyKey String @unique watchMatchId String channel String provider String status String attemptCount Int @default(1) lastAttemptAt DateTime? sentAt DateTime? failedAt DateTime? providerResponse Json? errorMessage String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt watchMatch WatchMatch @relation(fields:[watchMatchId],references:[id],onDelete:Cascade) @@index([status,channel]) }
model WatchRun { id String @id @default(uuid()) watchId String startedAt DateTime @default(now()) completedAt DateTime? status String sourcesRequested Json sourcesSucceeded Json sourcesFailed Json jobsFetched Int @default(0) jobsNormalized Int @default(0) newJobsDetected Int @default(0) matchesCreated Int @default(0) notificationsSent Int @default(0) durationMs Int? errorSummary String? createdAt DateTime @default(now()) watch JobWatch @relation(fields:[watchId],references:[id],onDelete:Cascade) @@index([watchId,startedAt]) @@index([status]) }
