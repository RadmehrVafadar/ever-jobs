{
  "schema_version": "1.2.0",
  "name": "ever-jobs",
  "display_name": "rad.ar",
  "description": "Multi-source job search and persistent watcher. Searches job boards, ATS platforms, and company career pages concurrently, returns normalized multi-location job postings, and can monitor target-scoped internship coverage through REST API and CLI.",
  "version": "0.1.0",
  "author": "Ever Co",
  "license": "MIT",
  "repository": "https://github.com/RadmehrVafadar/rad.ar",

  "capabilities": {
    "job_search": {
      "description": "Search for jobs across multiple job boards simultaneously",
      "supported_sites": {
        "job_boards": ["linkedin", "indeed", "glassdoor", "zip_recruiter", "google", "bayt", "naukri", "bdjobs", "internshala", "exa", "upwork", "dice", "simplyhired", "wellfound", "stepstone", "monster", "careerbuilder", "builtin", "snagajob", "dribbble", "solidjobs"],
        "remote_boards": ["remoteok", "remotive", "weworkremotely", "jobicy", "himalayas", "arbeitnow"],
        "ats_platforms": ["greenhouse", "lever", "ashby", "workable", "smartrecruiters", "jobvite", "workday", "successfactors", "taleo", "icims", "yello", "adp", "ukg", "rippling", "recruitee", "teamtailor", "bamboohr", "personio", "jazzhr"],
        "company_pages": ["amazon", "apple", "microsoft", "nvidia", "tiktok", "uber", "cursor", "google_careers", "shopify", "meta", "netflix", "stripe", "openai", "notion", "ramp", "ibm", "accenture"],
        "aggregators": ["usajobs", "adzuna", "reed", "jooble", "careerjet"]
      },
      "output_formats": ["json", "csv", "table", "summary"],
      "features": [
        "Multi-board concurrent searching (65+ sources)",
        "Country-aware domain resolution (65+ countries)",
        "ATS board searching with company slug",
        "Company-specific career page scraping",
        "Salary extraction from descriptions",
        "Annual salary normalization",
        "Proxy rotation (HTTP/HTTPS/SOCKS5)",
        "Rate limiting",
        "Remote job filtering",
        "Job type filtering",
        "HTTP job-posting liveness verification (active/expired/uncertain verdicts)",
        "Description format selection (markdown, html, plain)",
        "Analytics (summary stats, company intelligence, site comparison)",
        "MCP server for AI assistant integration"
      ]
    },
    "watch_management": {
      "description": "Persist, baseline, schedule, inspect, and safely update target-aware job watches",
      "preset": "canadian-tech-internships",
      "preset_revision": 1,
      "available_presets": [
        {
          "id": "canadian-tech-internships",
          "name": "Canadian Tech Internships",
          "revision": 1,
          "configured_companies": 26,
          "first_class_covered_companies": 21
        },
        {
          "id": "canadian-tech-adjacent-internships",
          "name": "Canadian Tech + Adjacent Internships",
          "revision": 1,
          "configured_companies": 41,
          "first_class_covered_companies": 41,
          "enabled_by_default": false,
          "initialized_by_default": false,
          "role_families": ["software-engineering", "data-ai", "cybersecurity", "cloud-platform-infrastructure", "qa-automation", "technical-product", "ux-product-design", "systems-business-analysis", "technology-risk-it-audit"]
        }
      ],
      "preset_apply": {
        "dry_run_command": "npm run cli -- watch preset apply canadian-tech-internships --watch <watch-id>",
        "apply_command": "npm run cli -- watch preset apply canadian-tech-internships --watch <watch-id> --apply",
        "expanded_dry_run_command": "npm run cli -- watch preset apply canadian-tech-adjacent-internships --watch <watch-id>",
        "expanded_apply_command": "npm run cli -- watch preset apply canadian-tech-adjacent-internships --watch <watch-id> --apply",
        "mutation_requires_paused_watch": true
      },
      "targeted_initialize": {
        "rest": "POST /api/watches/:id/initialize with optional { targetKeys: string[] }",
        "cli": "npm run cli -- watch initialize <watch-id> --target <target-key>",
        "target_option_repeatable": true,
        "omitted_targets_initialize_all": true
      },
      "source_target_contract": {
        "default_inheritance": {
          "intervalMinutes": "Omit sourceTargets[].intervalMinutes to inherit watch.intervalMinutes.",
          "countryCodes": "Omit sourceTargets[].searchScope.countryCodes to inherit watch.countryCodes.",
          "locations": "Omit sourceTargets[].searchScope.locations to inherit watch.locations.",
          "searchTerms": "Omit sourceTargets[].searchScope.searchTerms to inherit watch.searchTerms.",
          "field_independent": true,
          "explicit_values_are_overrides": true
        },
        "resultsWanted": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "optional": true,
          "legacy_default_behavior": "When omitted, the watcher executor uses its configured default."
        },
        "mode": {
          "type": "string",
          "values": ["board", "board-search", "query"],
          "optional": true,
          "board_search_behavior": "Rotates bounded term-only requests and applies strict geography after normalization."
        },
        "companyUrl": {
          "type": "string",
          "format": "uri",
          "optional": true,
          "description": "Official vanity-domain ATS listing URL forwarded to the source adapter."
        },
        "persistence": "Stored in the existing sourceTargets JSON; no database migration is required.",
        "material_diff_fields": ["resultsWanted", "mode", "companyUrl", "searchScope"]
      },
      "company_coverage": {
        "rest": "GET /api/watches/:id/coverage",
        "cli": "npm run cli -- watch coverage --id <watch-id>",
        "authentication": "Uses the existing watch-management API-key policy.",
        "matching": "Normalized exact company name against sourceTargets[].companyName; generic discovery boards do not count.",
        "statuses": ["active", "disabled", "uncovered"],
        "summary_counts": ["configured", "active", "disabled", "uncovered", "initialized", "degraded"],
        "target_company_inventory": {
          "configured": 26,
          "covered": 21,
          "deferred_uncovered": ["RBC", "TD", "Scotiabank", "BMO", "CIBC"]
        },
        "expanded_target_company_inventory": {
          "configured": 41,
          "covered": 41,
          "deferred_uncovered": [],
          "added_employer_groups": ["RBC", "TD", "Scotiabank", "BMO", "CIBC", "KPMG", "PwC", "Deloitte Canada", "EY Canada", "Accenture Canada", "Aritzia", "Loblaw", "Canadian Tire", "Canada Goose", "Manulife", "Sun Life", "Intact", "Bell", "Rogers", "TELUS"]
        }
      },
      "geography": {
        "tier_1": ["CA"],
        "tier_2": ["CA"],
        "tier_3": ["CA"],
        "strict_locations": true,
        "locations": ["Toronto, Ontario", "Greater Toronto Area", "Mississauga, Ontario", "Brampton, Ontario", "Vaughan, Ontario", "Richmond Hill, Ontario", "Markham, Ontario", "Oakville, Ontario", "Burlington, Ontario", "Pickering, Ontario", "Ajax, Ontario"]
      },
      "shipped_preset_state": {
        "watch_enabled": false,
        "watch_initialized": false,
        "target_enabled_does_not_poll_or_notify_while_watch_disabled": true,
        "enabled_target_keys": ["google_careers", "shopify", "ashby:wealthsimple", "ashby:plaid", "amazon", "microsoft", "apple", "nvidia", "stripe", "openai", "datadog", "doordash", "coinbase", "figma", "vercel", "meta", "wellfound", "uber", "notion", "ramp", "netflix", "ibm", "canadajobbank", "linkedin"],
        "disabled_target_keys": ["google"],
        "bounded_board_target_keys": ["uber", "notion", "ramp", "netflix", "ibm"],
        "bounded_board_results_wanted": 500
      },
      "query_matrices": {
        "google_careers": { "entries": 209, "max_requests_per_run": 1 },
        "canadajobbank": { "entries": 209, "max_requests_per_run": 12 },
        "google": { "entries": 209, "max_requests_per_run": 12 },
        "linkedin": { "entries": 209, "max_requests_per_run": 8, "recent_window_hours": 72 }
      },
      "board_search": {
        "terms": ["Summer 2027", "May 2027", "intern", "co-op"],
        "max_requests_per_ten_minute_run": 2,
        "multiplies_terms_by_locations": false,
        "location_filter_stage": "after normalization"
      },
      "activation_policy": "Keep the watch paused; preview/apply the Canadian Tech Internships preset, baseline every added or materially changed enabled target without notifications, review failures and results, then explicitly resume",
      "canonical_identity": {
        "delivery_key": ["watch", "canonical_episode", "channel", "destination"],
        "notification_type_in_key": false,
        "fallback_episode": "First-observation-anchored rolling 14-day episode; not a UTC calendar bucket",
        "stable_source_repost": "Preserve the prior observation and create an episode-scoped observation snapshot after rollover",
        "suppression_promotion": "Eligibility suppression may promote once; baseline and sent states are terminal"
      },
      "target_health": {
        "outcomes": ["success", "empty", "partial", "hard_failure"],
        "consecutive_hard_failures_reset_on": ["success", "empty", "partial"],
        "tier_1_degraded_at": 3
      },
      "metrics": {
        "company_coverage": "ever_jobs_watcher_company_coverage{watch_id,status}",
        "company_coverage_status_labels": ["configured", "active", "disabled", "uncovered", "initialized", "degraded"],
        "source_total": "ever_jobs_sources_total is initialized from the discovered plugin-registry count"
      },
      "validation_evidence": {
        "deterministic_suites_pre_phase_13": 6,
        "deterministic_tests_pre_phase_13": 59,
        "google_careers": "Live pass: 2 Canadian roles",
        "shopify": "Live pass: marker-validated valid empty board",
        "wealthsimple": "Live pass: 37 roles with capped mapped sample",
        "linkedin": "Unauthenticated public listing/detail live pass",
        "microsoft": "Live timeout; target remains operator-enabled inside the globally disabled watch",
        "google": "SOURCE_BLOCKED enable-JavaScript shell; target disabled",
        "phase_13_rollout_gate": "Fixture validation, operator-authorized disabled live smokes, targeted baselines, and two no-notification observation cycles for uber, notion, ramp, netflix, and ibm",
        "spec_6004_live_smoke": {
          "date": "2026-08-12",
          "command": "npm run smoke:canadian-employers -- --json",
          "exit_code": 0,
          "endpoints": 22,
          "employer_groups": 20,
          "parsed_job_passes": 18,
          "authoritative_empty": ["Loblaw main", "PC Financial", "Shoppers Drug Mart", "Bell"],
          "failures": 0,
          "invalid_direct_urls": 0,
          "kpmg": {
            "advertised": 28,
            "parsed": 25,
            "gta": 23,
            "summer_2027": 19,
            "gta_summer_2027_role": 4,
            "valid_direct_urls": 25
          },
          "deloitte_canada": {
            "advertised": 109,
            "parsed": 25,
            "gta": 25,
            "role_matches": 1,
            "summer_2027": 0,
            "valid_direct_urls": 25
          },
          "interpretation": "Endpoint/parser evidence for the dated run only; it does not claim every employer currently has a qualifying GTA Summer 2027 role."
        }
      },
      "linkedin_policy": "Unauthenticated public guest search only; newest-first 72-hour window; no login, personal cookies, CAPTCHA bypass, or personalized-alert parity claim"
    }
  },

  "usage": {
    "cli": {
      "command": "npm run cli -- search",
      "stdin_mode": "echo '{\"searchTerm\": \"engineer\"}' | npm run cli -- search --stdin",
      "help": "npm run cli -- search --help"
    },
    "api": {
      "endpoint": "POST /api/jobs/search",
      "docs": "http://localhost:3001/api/docs"
    },
    "watcher": {
      "initialize_endpoint": "POST /api/watches/:id/initialize",
      "initialize_body": { "targetKeys": ["uber", "notion", "ramp", "netflix", "ibm"] },
      "coverage_endpoint": "GET /api/watches/:id/coverage",
      "coverage_command": "npm run cli -- watch coverage --id <watch-id>",
      "expanded_preset_preview_command": "npm run cli -- watch preset apply canadian-tech-adjacent-internships --watch <watch-id>",
      "expanded_preset_apply_command": "npm run cli -- watch preset apply canadian-tech-adjacent-internships --watch <watch-id> --apply",
      "canadian_employer_live_smoke_command": "npm run smoke:canadian-employers",
      "health_endpoint": "GET /health",
      "metrics_endpoint": "GET /metrics"
    }
  },

  "input_schema": {
    "type": "object",
    "properties": {
      "searchTerm": {
        "type": "string",
        "description": "Job search keywords (e.g., 'software engineer')"
      },
      "siteType": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Sites to search. Omit to search all search + company sources. Provide companySlug for ATS sources."
      },
      "companySlug": {
        "type": "string",
        "description": "Company identifier for ATS scrapers (e.g., 'stripe', 'notion'). When set without siteType, only ATS scrapers run."
      },
      "location": {
        "type": "string",
        "description": "Location to search near (e.g., 'San Francisco, CA')"
      },
      "resultsWanted": {
        "type": "integer",
        "default": 15,
        "description": "Number of results per site"
      },
      "country": {
        "type": "string",
        "default": "USA",
        "description": "Country for Indeed/Glassdoor domain resolution"
      },
      "hoursOld": {
        "type": "integer",
        "description": "Max job age in hours"
      },
      "isRemote": {
        "type": "boolean",
        "default": false,
        "description": "Filter for remote jobs only"
      },
      "jobType": {
        "type": "string",
        "enum": ["fulltime", "parttime", "internship", "contract"],
        "description": "Filter by job type"
      },
      "descriptionFormat": {
        "type": "string",
        "enum": ["markdown", "html", "plain"],
        "default": "markdown",
        "description": "Format for job descriptions"
      },
      "enforceAnnualSalary": {
        "type": "boolean",
        "default": false,
        "description": "Convert all wages to annual equivalent"
      },
      "rateDelayMin": {
        "type": "number",
        "description": "Minimum delay between requests in seconds"
      },
      "rateDelayMax": {
        "type": "number",
        "description": "Maximum delay between requests in seconds"
      },
      "linkedinFetchDescription": {
        "type": "boolean",
        "default": false,
        "description": "Fetch full LinkedIn job descriptions (slower but more detailed)"
      },
      "linkedinCompanyIds": {
        "type": "array",
        "items": { "type": "integer" },
        "description": "Filter LinkedIn results by company IDs"
      },
      "proxies": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Proxy URLs for rotation"
      }
    },
    "required": []
  },

  "output_schema": {
    "type": "object",
    "properties": {
      "count": { "type": "integer", "description": "Total number of jobs found" },
      "cached": { "type": "boolean", "description": "Whether results came from cache" },
      "jobs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "site": { "type": "string" },
            "title": { "type": "string" },
            "companyName": { "type": "string" },
            "companyUrl": { "type": "string" },
            "jobUrl": { "type": "string" },
            "jobUrlDirect": { "type": "string" },
            "location": {
              "type": "object",
              "description": "Primary compatibility location; when locations is present this is its first entry",
              "properties": {
                "city": { "type": "string" },
                "state": { "type": "string" },
                "country": { "type": "string" }
              }
            },
            "locations": {
              "type": "array",
              "description": "All normalized advertised locations in stable source order",
              "items": {
                "type": "object",
                "properties": {
                  "city": { "type": "string" },
                  "state": { "type": "string" },
                  "country": { "type": "string" }
                }
              }
            },
            "description": { "type": "string" },
            "datePosted": { "type": "string", "format": "date" },
            "isRemote": { "type": "boolean" },
            "jobType": { "type": "array", "items": { "type": "string" } },
            "compensation": {
              "type": "object",
              "properties": {
                "interval": { "type": "string" },
                "minAmount": { "type": "number" },
                "maxAmount": { "type": "number" },
                "currency": { "type": "string" }
              }
            },
            "emails": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  },

  "examples": [
    {
      "name": "Basic job search",
      "input": {
        "searchTerm": "software engineer",
        "siteType": ["indeed"],
        "location": "San Francisco",
        "resultsWanted": 5
      }
    },
    {
      "name": "Remote TypeScript jobs",
      "input": {
        "searchTerm": "typescript developer",
        "siteType": ["linkedin", "indeed"],
        "isRemote": true,
        "resultsWanted": 20
      }
    },
    {
      "name": "Business development intelligence",
      "input": {
        "searchTerm": "VP engineering",
        "siteType": ["linkedin"],
        "location": "New York",
        "resultsWanted": 50,
        "linkedinFetchDescription": true,
        "descriptionFormat": "plain"
      }
    }
  ]
}
